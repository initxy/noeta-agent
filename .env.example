# noeta-agent configuration. Every key is optional; with everything left empty
# the workbench runs fully offline (mock LLM, no Docker, no credentials) and
# still boots into a usable product. There is no login screen.

# --- server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Only needed when the frontend is served separately (vite dev).
CORS_ORIGINS=

# --- storage ---
# Derives workspaces/, memories/, app.db and noeta.db underneath.
DATA_DIR=data
# Default parent directory for "create a new project directory for me".
PROJECTS_DIR=

# --- LLM gateway (OpenAI Responses-compatible) ---
# auto = use the gateway when base URL + key are set, otherwise the offline mock.
LLM_PROVIDER=auto
# The gateway ROOT; the provider appends /responses itself.
LLM_BASE_URL=
LLM_API_KEY=

# Optional secondary gateway for models tagged "gateway": "secondary" in
# models.json (multi-gateway routing).
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_API_KEY=

MODELS_CONFIG=models.json
LLM_REQUEST_TIMEOUT=300.0
LLM_MAX_TOKENS=8192
# Must be a NON-reasoning model: the title call sends reasoning effort "none".
TITLE_MODEL=
# Model for the compaction summarize call only (issued non-streaming). Must be a
# model that answers on the non-streaming path, or long sessions fail at
# compaction with compaction_summary_failed. Empty = use the per-turn model.
COMPACTION_MODEL=

# --- sandbox execution tier (requires Docker) ---
# There is no global on/off switch any more: the execution tier is a per-project
# choice (local | sandbox) stored with the project. These keys configure the
# container used by projects that choose the sandbox tier.
#
# WARNING: a project on the `local` tier runs the agent on this machine with NO
# container isolation and NO per-call approval prompt. File writes stay fenced
# to the project directory; shell commands do NOT.
SANDBOX_IMAGE=
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# The NAME of the env var holding the sandbox key — never the value itself.
SANDBOX_API_KEY_ENV=SANDBOX_API_KEY
# 0 = ephemeral, discovered at boot. Pin it when behind a firewall.
SANDBOX_PREVIEW_PORT=0
# Two-stage idle reclamation. 0 disables that stage; both 0 = no reaper thread.
SANDBOX_IDLE_STOP_HOURS=1.0
SANDBOX_IDLE_REMOVE_HOURS=24.0
SANDBOX_IDLE_CHECK_INTERVAL_HOURS=0.1

# --- agent capabilities ---
MEMORY_CONSOLIDATION=true
MEMORY_CONSOLIDATION_DEBOUNCE_HOURS=24.0
AGENT_NUM_WORKERS=4

# --- observability (OTLP trace export, opt-in) ---
# Full OTLP/HTTP traces URL, e.g. http://localhost:4318/v1/traces.
# Empty = no export. The ambient OTel-standard OTEL_EXPORTER_OTLP_ENDPOINT is
# deliberately NOT honored as an enable switch.
OTLP_ENDPOINT=
# Extra headers on every export request (comma-separated k=v pairs, values
# percent-encoded per the OTel spec, e.g. authorization=Bearer%20token).
# Falls back to the OTel-standard OTEL_EXPORTER_OTLP_HEADERS when unset;
# applied only when OTLP_ENDPOINT is set.
OTLP_HEADERS=
